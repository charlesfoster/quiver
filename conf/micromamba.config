/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER micromamba profile — like mamba but uses the standalone micromamba binary.
    Useful when a full conda/mamba base installation is not available (e.g. CI, HPC).
    If you already have mamba installed, use -profile mamba instead.
    Install: brew install micromamba  OR  https://mamba.readthedocs.io/en/latest/
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'local'
}

conda {
    enabled              = true
    useMicromamba        = true
    channels             = ['conda-forge', 'bioconda']
    createOptions        = '--yes'
}

docker.enabled       = false
singularity.enabled  = false
podman.enabled       = false
shifter.enabled      = false
charliecloud.enabled = false
apptainer.enabled    = false
