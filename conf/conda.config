/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hcv-quasi conda profile — any platform with conda or mamba installed.
    Each process uses its own per-module environment.yml (${moduleDir}/environment.yml).
    On macOS ARM64, conda resolves native osx-arm64 packages automatically.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'local'
}

conda {
    enabled       = true
    useMicromamba = false
}
