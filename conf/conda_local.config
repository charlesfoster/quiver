/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hcv-quasi conda_local profile — Mac M5 Max, no Docker
    Uses micromamba to activate env/hcv-quasi.yml.
    Native ARM64 builds available for most bioinformatics tools via conda-forge.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'local'
    conda    = "${projectDir}/env/hcv-quasi.yml"
}

conda {
    enabled       = true
    useMicromamba = true
}
