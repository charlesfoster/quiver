/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER mamba profile — like conda but uses mamba for faster dependency solving.
    Requires mamba to be installed (conda install -n base -c conda-forge mamba).
    On macOS ARM64, mamba resolves native osx-arm64 packages automatically.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'local'
}

conda {
    enabled              = true
    useMamba             = true
    channels             = ['conda-forge', 'bioconda']
    createOptions        = '--yes'
}

docker.enabled       = false
singularity.enabled  = false
podman.enabled       = false
shifter.enabled      = false
charliecloud.enabled = false
apptainer.enabled    = false
