/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER singularity profile — Singularity / Apptainer container engine.
    Combine with an executor profile for HPC use, e.g.:
        -profile singularity,katana
        -profile singularity,gadi
    Or run locally:
        -profile singularity
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

singularity {
    enabled    = true
    autoMounts = true
}

conda.enabled        = false
docker.enabled       = false
podman.enabled       = false
shifter.enabled      = false
charliecloud.enabled = false
apptainer.enabled    = false
