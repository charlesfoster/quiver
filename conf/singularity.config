/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hcv-quasi singularity profile — Singularity / Apptainer container engine.
    Combine with an executor profile for HPC use, e.g.:
        -profile singularity,katana
        -profile singularity,gadi
    Or run locally:
        -profile singularity
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

singularity {
    enabled    = true
    autoMounts = true
}
