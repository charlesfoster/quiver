/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER docker_mac profile — Docker Desktop on Apple Silicon.

    Extends the docker profile with two Apple Silicon-specific overrides:
      1. --platform=linux/amd64 — forces Rosetta 2 emulation (most biocontainers
         are amd64-only; without this flag Docker refuses to pull them on arm64).
      2. LoFreq serial mode — the amd64 LoFreq container OOM/SIGKILLs under
         emulation when call-parallel spawns multiple child processes concurrently.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

docker.runOptions        = '-u $(id -u):$(id -g) --platform=linux/amd64'
params.lofreq_pp_threads = 1

process {
    withName: 'LOFREQ_CALL' {
        cpus     = 1
        maxForks = 1
        memory   = null
    }
}
