/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hcv-quasi docker_mac profile — Docker Desktop on Apple Silicon.

    This profile inherits the standard Docker profile and then disables LoFreq's
    internal call-parallel fan-out.  The LoFreq biocontainer is amd64-only here,
    so Docker Desktop runs it under emulation; serial calling is slower but avoids
    repeated SIGKILL/OOM failures from multiple concurrent lofreq child processes.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params.lofreq_pp_threads = 1

process {
    withName: 'LOFREQ_CALL' {
        cpus     = 1
        maxForks = 1
        memory   = null
    }
}
