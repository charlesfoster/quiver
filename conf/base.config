/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER base process configuration
    Resource limits enforced via process.resourceLimits (Nextflow >= 24.10 native cap).
    Label values scale with task.attempt for automatic retry with more resources.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Enforce hard caps from params.max_* at the engine level
    // (replaces the legacy check_max() helper pattern)
    resourceLimits = [
        cpus:   params.max_cpus   as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time:   params.max_time   as nextflow.util.Duration
    ]

    // Default error strategy: retry up to 2 times with increasing resources
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ------------------------------------------------------------------
    // Resource labels
    // Values from docs/implementation_prompts.md Prompt 1:
    //   process_low:         cpus 1,  memory 2.GB,  time 30.min
    //   process_medium:      cpus 4,  memory 8.GB,  time 2.h
    //   process_high:        cpus 16, memory 32.GB, time 12.h
    //   process_high_memory: cpus 16, memory 64.GB, time 12.h
    // ------------------------------------------------------------------

    withLabel: process_low {
        cpus   = { 1  * task.attempt }
        memory = { 2.GB  * task.attempt }
        time   = { 30.min * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 4  * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 16 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withLabel: process_high_memory {
        cpus   = { 16 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

}
