/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER katana profile — UNSW Katana HPC (SLURM executor + resource limits).
    Use with -profile singularity,katana (Singularity is the standard engine on Katana).
    Adjust --account to your allocation code.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor       = 'slurm'
    queue          = { task.memory > 64.GB ? 'high_mem' : 'normal' }
    clusterOptions = '--account=oz000'
    scratch        = '$TMPDIR'
}

singularity {
    cacheDir = "/srv/scratch/${USER}/.singularity_cache"
}

params.max_cpus   = 32
params.max_memory = '256.GB'
params.max_time   = '48.h'
