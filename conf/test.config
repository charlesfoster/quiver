/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER test profile — synthetic minimal test dataset
    Paths under test_data/ are created by Prompt 25; they do not exist in the
    scaffold stage. The profile is defined here so the skeleton parses correctly.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input           = "${projectDir}/test_data/samplesheet.csv"
    // Use the real reference panel so simulation reads (from real accessions) map correctly.
    // mini_panel.fasta contains only synthetic sequences and will not give valid results
    // with reads simulated from accessions such as AF009606.1.
    reference_panel = "${projectDir}/assets/hcv_references.fasta"
    host_reference  = "${projectDir}/test_data/mini_host.fasta"
    max_cpus        = 4
    max_memory      = '8.GB'
    max_time        = '2.h'
}
