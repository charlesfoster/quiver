/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hcv-quasi test profile — synthetic minimal test dataset
    Paths under test_data/ are created by Prompt 25; they do not exist in the
    scaffold stage. The profile is defined here so the skeleton parses correctly.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input           = "${projectDir}/test_data/samplesheet.csv"
    reference_panel = "${projectDir}/test_data/mini_panel.fasta"
    host_reference  = "${projectDir}/test_data/mini_host.fasta"
    max_cpus        = 4
    max_memory      = '8.GB'
    max_time        = '2.h'
}
