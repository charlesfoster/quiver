/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hcv-quasi local profile — Mac M5 Max
    Leave 8 GB headroom for macOS (56 GB usable of 64 GB).
    Biocontainers are increasingly multi-arch; if a tool is x86-only Docker uses
    Rosetta 2 (~30-50% slower). For production-scale local runs prefer conda_local.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'local'
    cpus     = { Math.min(task.cpus, 12) }
    memory   = { Math.min(task.memory.toGiga(), 56).GB }
}

docker {
    enabled    = true
    runOptions = '--platform=linux/amd64'  // Rosetta fallback if no arm64 image
}

params.max_cpus   = 12
params.max_memory = '56.GB'
