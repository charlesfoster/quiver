/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per-module options and publishing paths.

    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
        publishDir = Override the module's default publishDir.
        memory     = Override the process label's memory for this module only.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ------------------------------------------------------------------
    // NANOQ — aliased invocations need distinct publishDir and prefix
    // so their outputs don't collide in MultiQC.
    // Default (RAW_QC) uses the module's own publishDir (qc/raw/).
    // ------------------------------------------------------------------
    withName: 'NANOQ_FILT' {
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/filtered/" },
            mode: 'copy'
        ]
    }

    withName: 'NANOQ_POSTHOST' {
        ext.prefix = { "${meta.id}.posthost" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/host_depleted/" },
            mode: 'copy'
        ]
    }

    // ------------------------------------------------------------------
    // LOFREQ_CALL — remove Docker's --memory cap for this process.
    //
    // lofreq call-parallel spawns N concurrent lofreq call subprocesses.
    // When Nextflow passes --memory 32768m to Docker, it sets a cgroup
    // memory limit that can exceed the Docker Desktop VM's total available
    // RAM on macOS (Apple Silicon). The VM's cgroup OOM killer then sends
    // SIGKILL to lofreq worker processes (exit 137), despite the container
    // nominally being allowed 32 GB. Setting memory = null prevents
    // Nextflow from emitting --memory, letting the workers compete fairly
    // for whatever the VM actually has.
    //
    // On native Linux HPC (Gadi, Katana) the node's RAM is real and the
    // memory directive causes no problems; HPC profiles re-set memory via
    // their own withName blocks if required for accurate job-scheduler
    // accounting.
    // ------------------------------------------------------------------
    withName: 'LOFREQ_CALL' {
        memory = null
    }
}
