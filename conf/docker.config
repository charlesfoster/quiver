/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    hcv-quasi docker profile — local Docker (Mac M-series / Intel Mac)
    Resource caps are tuned for a Mac M5 Max (64 GB RAM, 12 performance cores).
    Adjust max_cpus / max_memory for your machine if needed.
    On Apple Silicon, Docker runs amd64 containers via Rosetta.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'local'
    cpus     = { Math.min(task.cpus, 12) }
    memory   = { Math.min(task.memory.toGiga(), 56).GB }
}

docker {
    enabled    = true
    runOptions = '--platform=linux/amd64'  // Rosetta fallback for arm64 hosts
}

params.max_cpus   = 12
params.max_memory = '56.GB'
