nextflow.enable.dsl = 2

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QuIVER Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

params {
    // --- Inputs ---
    input               = null                                          // samplesheet CSV (required)
    reference_panel     = "${projectDir}/assets/hcv_references.fasta"  // 238-sequence HCV panel
    host_reference      = null                                          // path to GRCh38 FASTA or .mmi (auto-downloaded if null)
    outdir              = "results"                                     // output directory

    // --- Host depletion ---
    // Specify at most one of use_nohuman / use_hostile / use_minimap2.
    // If none is set, nohuman is used by default (fast Kraken2-based depletion).
    skip_host_depletion       = false   // bypass host depletion entirely (not recommended for clinical samples)
    use_nohuman               = false   // use nohuman (Kraken2-based) — default when none specified
    use_hostile               = false   // use hostile for host depletion (requires --host_reference)
    use_minimap2              = false   // use minimap2 alignment vs GRCh38 (auto-downloads if no --host_reference)

    // nohuman database cache (~4 GB Kraken2 DB, downloaded once by DOWNLOAD_NOHUMAN_DB)
    nohuman_db                = "${System.getenv('HOME') ?: '/tmp'}/.quiver/nohuman_db"
    force_nohuman_db_download = false   // force re-download even if cached database exists

    // minimap2 host reference cache (GRCh38 no-alt .mmi, only used with --use_minimap2)
    host_genome_cache          = "${System.getenv('HOME') ?: '/tmp'}/.quiver/references"
    force_host_genome_download = false  // force re-download + re-index even if cached .mmi exists

    // --- Read filtering ---
    min_length          = 200      // minimum read length (bp)
    max_length          = 10000    // maximum read length (bp); >10kb likely chimeric
    min_qual            = 8        // minimum mean Phred quality score

    // --- Genotyping / mixed infection ---
    min_secondary_fraction  = 0.05  // fraction of reads to secondary genotype that triggers mixed flag
    ambiguous_delta_as      = 20    // AS score gap to flag a read as ambiguous
    min_round1_mapped       = 100   // minimum primary mapped reads to proceed past Round 1

    // --- Coverage thresholds ---
    min_mean_coverage   = 100  // mean coverage below this → skip DEVIDER, flag LOW_COVERAGE
    min_consensus_cov   = 10   // per-position coverage below this → mask with N in consensus
    min_variant_depth   = 20   // LoFreq DP filter

    // --- Variant calling ---
    min_call_af         = 0.005  // LoFreq lower bound for raw calls
    min_report_af       = 0.01   // reporting AF threshold (1%)
    min_mq              = 20     // minimum mapping quality for variant calling
    min_bq              = 7      // minimum base quality for variant calling
    min_alt_bq          = 7      // minimum alt base quality for variant calling
    lofreq_sig          = 0.01   // LoFreq significance threshold
    lofreq_no_baq       = true   // Disable BAQ (-B); improves sensitivity on ONT reads (DEVIDER paper)
    lofreq_pp_threads   = 8      // LoFreq call-parallel workers; <=1 uses serial lofreq call
    // LoFreq computes INFO/SB (Phred-scaled Fisher's exact test p-value) but does NOT apply it as a
    // filter by default — call-parallel's internal lofreq filter only gates on SNV quality, not SB.
    // At 5000x depth Fisher's test is hypersensitive: even modest strand imbalance yields enormous SB.
    // SB=200 (p < 10^-20) was chosen empirically on a test sample: removes 122/1278 PASS variants (10%),
    // all showing clustered multi-allelic high-SB calls characteristic of alignment artefacts in
    // repetitive/homopolymer regions, while not over-filtering depth-inflated but real variants.
    max_sb              = 200    // maximum INFO/SB Phred score; variants above this are excluded

    // --- Depth normalisation ---
    lofreq_max_depth    = 5000  // rasusa depth cap for LoFreq input BAM
    devider_max_depth   = 5000  // rasusa depth cap for DEVIDER input BAM
    rasusa_seed_lofreq  = 42    // random seed for rasusa (LoFreq)
    rasusa_seed_devider = 43    // random seed for rasusa (DEVIDER)

    // --- Haplotype ---
    devider_min_read_length = 4000  // minimum read length fed to DEVIDER (applied before rasusa_aln)
    devider_min_cov     = 10    // DEVIDER --min-cov: per-window depth floor
    devider_min_abund   = 0.25  // DEVIDER --min-abund: minimum haplotype abundance (literal percent: 0.25 = 0.25%)
    devider_min_af      = 0.05  // AF threshold for VCF fed to DEVIDER (default 5%); higher than min_report_af
                                // to prevent low-AF variant noise from saturating DEVIDER's phasing graph

    // --- Run-mode toggles ---
    run_clair3           = false  // run Clair3 corroboration calling (opt-in)
    allow_conda_fallback = false  // allow conda when container not available

    // --- Clair3 ---
    // Override with --clair3_model_dir to supply a custom model directory.
    // The default resolves to the r1041_e82_400bps_hac_v520 model bundled
    // inside the quay.io/biocontainers/clair3:1.0.10--py39hf5e1c6e_2 container.
    // Set to null here so the fallback logic in modules/local/clair3/main.nf
    // applies the default path only when no override is provided.
    clair3_model_dir     = null   // path to Clair3 model directory; null = use container default

    // --- Profile-specific params ---
    gadi_project        = null  // NCI Gadi project code (required with -profile gadi)

    // --- Help ---
    help                = false

    // --- Resources (overridable per-profile) ---
    // These feed into process.resourceLimits in base.config
    max_cpus    = 16
    max_memory  = '64.GB'
    max_time    = '24.h'
}

// -----------------------------------------------------------------------
// Always-on base config (resource labels + resource limits)
// -----------------------------------------------------------------------
includeConfig 'conf/base.config'

// -----------------------------------------------------------------------
// Profiles
// -----------------------------------------------------------------------
profiles {

    // -----------------------------------------------------------------------
    // Development / debugging
    // -----------------------------------------------------------------------
    debug {
        dumpHashes                                   = true
        process.beforeScript                         = 'echo $HOSTNAME'
        cleanup                                      = false
        nextflow.enable.configProcessNamesValidation = true
    }

    // -----------------------------------------------------------------------
    // Container engines
    // -----------------------------------------------------------------------
    docker {
        includeConfig 'conf/docker.config'
    }
    docker_mac {
        // docker profile + Apple Silicon emulation + LoFreq serial mode.
        // Use when running Docker Desktop on an M-series Mac.
        includeConfig 'conf/docker.config'
        includeConfig 'conf/docker_mac.config'
    }
    emulate_amd64 {
        // Composable modifier: add to docker profile to force Rosetta 2 emulation.
        //   nextflow run main.nf -profile docker,emulate_amd64
        // Equivalent to docker_mac but without the LoFreq serial constraint.
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        includeConfig 'conf/singularity.config'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }
    podman {
        podman.enabled       = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
    }

    // -----------------------------------------------------------------------
    // Conda / package managers
    // -----------------------------------------------------------------------
    conda {
        includeConfig 'conf/conda.config'
    }
    mamba {
        includeConfig 'conf/mamba.config'
    }
    micromamba {
        includeConfig 'conf/micromamba.config'
    }

    // -----------------------------------------------------------------------
    // Wave (Seqera container streaming — pulls/builds containers on demand)
    // -----------------------------------------------------------------------
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }

    // -----------------------------------------------------------------------
    // HPC executors
    // -----------------------------------------------------------------------
    katana {
        includeConfig 'conf/katana.config'
    }
    gadi {
        includeConfig 'conf/gadi.config'
    }

    // -----------------------------------------------------------------------
    // Testing
    // -----------------------------------------------------------------------
    test {
        includeConfig 'conf/test.config'
    }
}

// -----------------------------------------------------------------------
// Per-module options (publishDir overrides, ext.args, ext.prefix, etc.)
// -----------------------------------------------------------------------
includeConfig 'conf/modules.config'

// -----------------------------------------------------------------------
// Manifest
// -----------------------------------------------------------------------
manifest {
    name            = 'quiver'
    author          = 'Charles Foster'
    homePage        = 'https://github.com/charlesfoster/quiver'
    description     = 'HCV quasispecies pipeline: low-frequency variant calling and haplotype reconstruction from ONT reads'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}

// -----------------------------------------------------------------------
// Execution reports — timestamped so reruns and resumes don't clobber
// previous traces. Each invocation gets its own set of files.
// -----------------------------------------------------------------------
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

